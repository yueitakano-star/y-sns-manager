# 本番/共有DB: Supabase等のPostgres接続文字列（サーバー専用。ブラウザへ出さない）
# 未設定の場合は、ローカル用の組み込みDB(PGlite)を ./.data/pglite に作成して使います。
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# 一時的にログイン省略（ローカル組み込みDB専用・DATABASE_URL設定時は無効）
# DEV_NO_AUTH=true
# 本番では true（Cookieにsecure属性を付ける）。ローカルのhttpなら false
COOKIE_SECURE=true
# PGliteの保存先（任意）。memory:// ならメモリのみ（テスト用）
# PGLITE_DIR=./.data/pglite

# ファイルアップロード(Supabase Storage・非公開バケット)。未設定ならアップロード欄は出ません
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=サーバー専用キー（絶対に公開しない）
# SUPABASE_BUCKET=materials
# MAX_UPLOAD_MB=2048
# 一時的にログイン省略（共有DBでも有効。URLを知る人は誰でも操作できます。使い終わったら必ず削除）
# NO_AUTH=true

# AIでキャプションを作る(Google Gemini)。未設定ならAIボタンは出ません
# GEMINI_API_KEY=Google AI Studioで取得したキー（サーバー専用）
# GEMINI_MODEL=gemini-3.8-flash

# Googleドライブ(読み取り専用)の取り込み。手順は docs/GOOGLE_DRIVE_SETUP.md
# GOOGLE_SERVICE_ACCOUNT_JSON=サービスアカウントのキーJSON(またはそのBase64)  ※サーバー専用
